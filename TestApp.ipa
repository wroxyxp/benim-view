name: Build Dylib and IPA
on: [push]
jobs:
  build:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: Randomblock1/theos-action@v1.6
      - run: make
      - name: Create Test IPA
        run: |
          rm -rf Payload TestApp.ipa
          mkdir -p Payload/TestApp.app
          cp .theos/obj/debug/BenimView.dylib Payload/TestApp.app/
          printf '#import <UIKit/UIKit.h>\n#import <dlfcn.h>\n@interface AppDelegate : UIResponder <UIApplicationDelegate>\n@property (strong, nonatomic) UIWindow *window;\n@end\n@implementation AppDelegate\n- (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {\nself.window = [[UIWindow alloc] initWithFrame:[UIScreen mainScreen].bounds];\nUIViewController *vc = [UIViewController new];\nvc.view.backgroundColor = [UIColor darkGrayColor];\nself.window.rootViewController = vc;\n[self.window makeKeyAndVisible];\nNSString *p = [[NSBundle mainBundle].bundlePath stringByAppendingPathComponent:@"BenimView.dylib"];\ndlopen([p UTF8String], RTLD_NOW);\nreturn YES;\n}\n@end\nint main(int argc, char * argv[]) { @autoreleasepool { return UIApplicationMain(argc, argv, nil, NSStringFromClass([AppDelegate class])); } }\n' > main.m
          printf '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">\n<plist version="1.0"><dict>\n<key>CFBundleExecutable</key><string>TestApp</string>\n<key>CFBundleIdentifier</key><string>com.benim.testapp</string>\n<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>\n<key>CFBundleName</key><string>TestApp</string>\n<key>CFBundlePackageType</key><string>APPL</string>\n<key>CFBundleShortVersionString</key><string>1.0</string>\n<key>CFBundleVersion</key><string>1</string>\n<key>LSRequiresIPhoneOS</key><true/>\n<key>MinimumOSVersion</key><string>14.0</string>\n<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>\n</dict></plist>\n' > Payload/TestApp.app/Info.plist
          xcrun --sdk iphoneos clang -arch arm64 -miphoneos-version-min=14.0 -framework UIKit -framework Foundation main.m -o Payload/TestApp.app/TestApp
          install_name_tool -change /Library/Frameworks/CydiaSubstrate.framework/CydiaSubstrate @rpath/CydiaSubstrate.framework/CydiaSubstrate Payload/TestApp.app/BenimView.dylib || true
          zip -r TestApp.ipa Payload
      - uses: actions/upload-artifact@v4
        with:
          name: TestApp-IPA
          path: TestApp.ipa
